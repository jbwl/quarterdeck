<div class="qd-stack">
  <!-- Filters -->
  <div class="card">
    <%= form_tag quarterdeck.visits_path, method: :get, class: "qd-filters" do %>
      <%= hidden_field_tag :period, period %>

      <div class="qd-field qd-field--grow">
        <label>Search</label>
        <%= text_field_tag :search, params[:search],
          placeholder: "Landing page, referrer, or IP...", class: "input" %>
      </div>

      <div class="qd-field">
        <label>Browser</label>
        <%= select_tag :browser, options_for_select(@browsers, params[:browser]), include_blank: "All", class: "input" %>
      </div>

      <div class="qd-field">
        <label>Device</label>
        <%= select_tag :device_type, options_for_select(@devices, params[:device_type]), include_blank: "All", class: "input" %>
      </div>

      <div class="qd-field">
        <label>OS</label>
        <%= select_tag :os, options_for_select(@operating_systems, params[:os]), include_blank: "All", class: "input" %>
      </div>

      <div class="qd-field">
        <label>Country</label>
        <%= select_tag :country, options_for_select(@countries_list, params[:country]), include_blank: "All", class: "input" %>
      </div>

      <div class="qd-field">
        <label class="flex items-center gap-half text-sm">
          <%= check_box_tag :utm_only, "1", params[:utm_only] == "1", class: "input" %>
          UTM only
        </label>
      </div>

      <%= submit_tag "Filter", class: "btn btn--primary" %>

      <% if params.to_unsafe_h.except("controller", "action", "period").values.any?(&:present?) %>
        <%= link_to "Clear", quarterdeck.visits_path(period: period), class: "btn btn--borderless" %>
      <% end %>
    <% end %>
  </div>

  <!-- Visits Table -->
  <div class="card">
    <div class="flex items-center justify-between mbe-3">
      <h3 class="font-semibold text-sm">Visits</h3>
      <%= link_to "Export CSV", url_for(request.query_parameters.merge(format: :csv)),
        class: "text-link text-xs" %>
    </div>
    <div class="qd-scroll">
      <table class="table">
        <thead>
          <tr>
            <th>Started</th>
            <th>Landing Page</th>
            <th>Referrer</th>
            <th>Browser</th>
            <th>Device</th>
            <th>Location</th>
            <th>UTM Source</th>
          </tr>
        </thead>
        <tbody>
          <% @visits.each do |visit| %>
            <tr>
              <td class="whitespace-nowrap">
                <%= link_to visit.started_at.strftime("%b %d, %H:%M"), quarterdeck.visit_path(visit), class: "text-link" %>
              </td>
              <td><span class="qd-truncate"><%= visit.landing_page %></span></td>
              <td><%= visit.referring_domain %></td>
              <td><%= visit.browser %></td>
              <td><%= visit.device_type %></td>
              <td><%= [ visit.city, visit.country ].compact_blank.join(", ") %></td>
              <td><%= visit.utm_source %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @pagy %>
      <div class="mbs-3">
        <%= render "quarterdeck/shared/pagination", pagy: @pagy %>
      </div>
    <% end %>
  </div>
</div>
