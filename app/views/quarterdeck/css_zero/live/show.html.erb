<div class="qcz-stack" data-controller="live" data-live-url-value="<%= quarterdeck_css_zero.live_path(format: :json) %>" data-live-interval-value="5000">
  <!-- Active Visitors -->
  <div class="card text-center">
    <div class="text-5xl font-bold" data-live-target="activeVisitors"><%= @active_visitors %></div>
    <p class="text-sm text-subtle mbs-2">active visitors in the last 5 minutes</p>
  </div>

  <div class="qcz-grid qcz-grid--2">
    <!-- Current Pages -->
    <div class="card">
      <h3 class="font-semibold text-sm mbe-3">Pages Being Viewed</h3>
      <div class="qcz-scroll">
        <table class="table qcz-table-live">
          <thead>
            <tr>
              <th>Page</th>
              <th class="text-end">Viewers</th>
            </tr>
          </thead>
          <tbody data-live-target="currentPages">
            <% if @current_pages.any? %>
              <% @current_pages.each do |url, count| %>
                <tr>
                  <td><span class="qcz-truncate"><%= url %></span></td>
                  <td class="text-end"><%= count %></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="2" class="text-center text-subtle">No active pages</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Live Event Stream -->
    <div class="card">
      <h3 class="font-semibold text-sm mbe-3">Live Event Stream</h3>
      <div class="qcz-scroll">
        <table class="table qcz-table-live">
          <thead>
            <tr>
              <th>Time</th>
              <th>Event</th>
              <th>Visitor</th>
            </tr>
          </thead>
          <tbody data-live-target="recentEvents">
            <% @recent_events.each do |event| %>
              <tr>
                <td class="whitespace-nowrap"><%= event.time.strftime("%H:%M:%S") %></td>
                <td><span class="badge"><%= event.name %></span></td>
                <td class="text-subtle"><%= event.visit&.visitor_token&.first(8) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
