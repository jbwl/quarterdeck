<div class="qcz-stack">
  <div class="flex items-center justify-end">
    <%= link_to "Export CSV", url_for(request.query_parameters.merge(format: :csv)),
      class: "text-link text-xs" %>
  </div>

  <!-- Countries -->
  <div class="qcz-grid qcz-grid--2">
    <%= render "quarterdeck/css_zero/shared/data_table", title: "Countries", label: "Country", count_label: "Visits", data: @countries %>

    <% if @countries.any? %>
      <div class="card">
        <h3 class="font-semibold text-sm mbe-4">Top Countries</h3>
        <div class="qcz-chart-frame">
          <%= quarterdeck_chart type: "doughnut",
            data: {
              labels: @countries.keys.first(8),
              datasets: [{
                data: @countries.values.first(8),
                backgroundColor: [ "#6366f1", "#818cf8", "#a5b4fc", "#c7d2fe", "#e0e7ff", "#4f46e5", "#4338ca", "#3730a3" ],
                borderWidth: 0
              }]
            },
            options: { plugins: { legend: { display: true } } } %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Regions & Cities -->
  <div class="qcz-grid qcz-grid--2">
    <%= render "quarterdeck/css_zero/shared/data_table", title: "Regions", label: "Region", count_label: "Visits", data: @regions %>
    <%= render "quarterdeck/css_zero/shared/data_table", title: "Cities", label: "City", count_label: "Visits", data: @cities %>
  </div>
</div>
