<%
  periods = [
    { label: "Today", value: "today" },
    { label: "7 days", value: "7d" },
    { label: "30 days", value: "30d" },
    { label: "90 days", value: "90d" }
  ]
%>
<div class="card flex flex-wrap items-center gap p-2">
  <div class="tabs__list">
    <% periods.each do |p| %>
      <% active = period == p[:value] %>
      <%= link_to p[:label],
        url_for(request.query_parameters.merge(period: p[:value]).except("start_date", "end_date", "page")),
        class: "btn tabs__button",
        "aria-current": (active ? "page" : nil) %>
    <% end %>
    <% if period == "custom" %>
      <span class="btn tabs__button" aria-current="page">Custom</span>
    <% end %>
  </div>

  <%= form_tag request.path, method: :get, class: "flex flex-wrap items-center gap mis-auto" do %>
    <% request.query_parameters.except("period", "start_date", "end_date", "page").each do |key, value| %>
      <%= hidden_field_tag key, value %>
    <% end %>
    <%= hidden_field_tag :period, "custom" %>
    <%= date_field_tag :start_date, params[:start_date], class: "input qcz-input", aria: { label: "Start date" } %>
    <span class="text-subtle text-sm">to</span>
    <%= date_field_tag :end_date, params[:end_date], class: "input qcz-input", aria: { label: "End date" } %>
    <%= submit_tag "Apply", class: "btn btn--secondary" %>
  <% end %>
</div>
