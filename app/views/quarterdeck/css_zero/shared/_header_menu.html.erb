<%# Desktop header menu: brand + the analytics sections (hidden below md), and a
    link back to the host app's root. %>
<div class="flex-1 flex items-center gap">
  <a class="flex items-center gap mie-2" href="<%= quarterdeck_css_zero.root_path %>">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
         style="inline-size: 1.5rem; block-size: 1.5rem">
      <path d="M3 3v18h18" />
      <path d="M7 16v-4" />
      <path d="M12 16V8" />
      <path d="M17 16v-7" />
    </svg>
    <span class="font-bold"><%= quarterdeck_site_title %></span>
  </a>

  <nav class="flex items-center gap text-sm text-subtle show@md" style="--column-gap: 1rem" aria-label="Analytics sections">
    <% quarterdeck_sections.each do |section| %>
      <%= link_to section[:name], section[:path],
        class: ("text-primary" if section[:active]),
        "aria-current": (section[:active] ? "page" : nil) %>
    <% end %>
  </nav>

  <%# `main_app` reaches the host application's routes from inside the engine. %>
  <%= link_to "Back to app", main_app.root_path, class: "mis-auto text-sm text-subtle" %>
</div>
