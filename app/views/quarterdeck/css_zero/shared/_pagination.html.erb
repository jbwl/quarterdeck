<% return if pagy.blank? %>
<%
  a_lambda = pagy.send(:a_lambda)
  series = pagy.send(:series)
%>
<nav class="pagination" aria-label="Pagination">
  <% if pagy.previous %>
    <%== a_lambda.(pagy.previous, "Previous", aria_label: "Previous page", classes: "btn pagination__button") %>
  <% else %>
    <span class="btn pagination__button" aria-disabled="true">Previous</span>
  <% end %>

  <% series.each do |item| %>
    <% if item.is_a?(Integer) %>
      <%== a_lambda.(item, item.to_s, classes: "btn pagination__button") %>
    <% elsif item.is_a?(String) %>
      <a role="link" aria-disabled="true" aria-current="page" class="btn pagination__button"><%= item %></a>
    <% elsif item == :gap %>
      <span class="pagination__button" aria-hidden="true">&hellip;</span>
    <% end %>
  <% end %>

  <% if pagy.next %>
    <%== a_lambda.(pagy.next, "Next", aria_label: "Next page", classes: "btn pagination__button") %>
  <% else %>
    <span class="btn pagination__button" aria-disabled="true">Next</span>
  <% end %>
</nav>
