<div class="qd-stack">
  <!-- Stats -->
  <div class="qd-grid qd-grid--stats">
    <%= render "quarterdeck/shared/stat_card", title: "Total Events", value: @total_events, previous_value: @prev_total_events %>
    <%= render "quarterdeck/shared/stat_card", title: "Unique Event Names", value: @unique_events, previous_value: @prev_unique_events %>
  </div>

  <!-- Filter by event name -->
  <div class="card">
    <%= form_tag quarterdeck.events_path, method: :get, class: "qd-filters" do %>
      <%= hidden_field_tag :period, period %>
      <div class="qd-field qd-field--grow">
        <label>Event Name</label>
        <%= select_tag :name, options_for_select(@event_names.map { |name, count| [ "#{name} (#{count})", name ] }, params[:name]), include_blank: "All Events", class: "input" %>
      </div>
      <%= submit_tag "Filter", class: "btn btn--primary" %>
      <% if params[:name].present? %>
        <%= link_to "Clear", quarterdeck.events_path(period: period), class: "btn btn--borderless" %>
      <% end %>
    <% end %>
  </div>

  <!-- Daily Events Chart -->
  <div class="card">
    <div class="flex items-center justify-between mbe-4">
      <h3 class="font-semibold text-sm">Events Over Time</h3>
      <%= link_to "Export CSV", url_for(request.query_parameters.merge(format: :csv)),
        class: "text-link text-xs" %>
    </div>
    <div class="qd-chart-frame">
      <%= quarterdeck_chart type: "bar",
        data: {
          labels: @daily_events.keys.map { |d| d.strftime("%b %d") },
          datasets: [{
            label: "Events",
            data: @daily_events.values,
            backgroundColor: "#6366f1",
            borderWidth: 0
          }]
        },
        options: { scales: { y: { beginAtZero: true } } } %>
    </div>
  </div>

  <!-- Event Breakdown -->
  <%= render "quarterdeck/shared/data_table", title: "Event Breakdown", label: "Event Name", count_label: "Count", data: @event_names %>

  <!-- Recent Events -->
  <div class="card">
    <h3 class="font-semibold text-sm mbe-3">Recent Events</h3>
    <div class="qd-scroll">
      <table class="table">
        <thead>
          <tr>
            <th>Time</th>
            <th>Name</th>
            <th>Properties</th>
          </tr>
        </thead>
        <tbody>
          <% @events.each do |event| %>
            <tr>
              <td class="whitespace-nowrap"><%= event.time.strftime("%b %d, %H:%M:%S") %></td>
              <td><span class="badge"><%= event.name %></span></td>
              <td>
                <% if event.properties.present? %>
                  <code class="qd-code"><%= event.properties.to_json %></code>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @pagy %>
      <div class="mbs-3">
        <%= render "quarterdeck/shared/pagination", pagy: @pagy %>
      </div>
    <% end %>
  </div>
</div>
