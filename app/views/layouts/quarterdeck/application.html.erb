<!DOCTYPE html>
<html data-color-scheme="system">
  <head>
    <title>Quarterdeck Analytics</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "css-zero/reset" %>
    <%= stylesheet_link_tag "css-zero/variables" %>
    <%= stylesheet_link_tag "quarterdeck" %>
    <%= stylesheet_link_tag "css-zero/utilities" %>

    <%= javascript_importmap_tags("quarterdeck/application") if respond_to?(:javascript_importmap_tags) %>
  </head>

  <body class="header-layout">
    <header id="header">
      <div class="container qd-stack">
        <h1 class="font-bold text-2xl">Quarterdeck</h1>
        <%= render "quarterdeck/shared/nav" %>
      </div>
    </header>

    <main id="main">
      <div class="container qd-stack">
        <%= render "quarterdeck/shared/period_tabs" %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
