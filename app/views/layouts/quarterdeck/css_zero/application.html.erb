<!DOCTYPE html>
<html data-color-scheme="system">
  <head>
    <title><%= quarterdeck_site_title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "css-zero/reset" %>
    <%= stylesheet_link_tag "css-zero/variables" %>
    <%= stylesheet_link_tag "quarterdeck-csszero" %>
    <%= stylesheet_link_tag "css-zero/utilities" %>

    <%= javascript_importmap_tags("quarterdeck-csszero/application") if respond_to?(:javascript_importmap_tags) %>
  </head>

  <body class="header-layout">
    <header id="header">
      <div class="flex items-center gap container">
        <%= render "quarterdeck/css_zero/shared/mobile_menu" %>
        <%= render "quarterdeck/css_zero/shared/header_menu" %>
      </div>
    </header>

    <main id="main">
      <div class="container flex flex-col gap">
        <%= render "quarterdeck/css_zero/shared/period_tabs" %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
