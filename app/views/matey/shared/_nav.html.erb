<%
  nav_items = [
    { name: "Overview", path: matey.root_path, active: controller_name == "overview" },
    { name: "Visits", path: matey.visits_path, active: controller_name == "visits" },
    { name: "Events", path: matey.events_path, active: controller_name == "events" },
    { name: "Campaigns", path: matey.campaigns_path, active: controller_name == "campaigns" },
    { name: "Geographic", path: matey.geographic_path, active: controller_name == "geographics" }
  ]
%>
<nav class="flex space-x-1 mb-4" aria-label="Tabs">
  <% nav_items.each do |item| %>
    <% if item[:active] %>
      <%= link_to item[:name], item[:path],
        class: "bg-indigo-100 text-indigo-700 px-4 py-2 font-medium text-sm rounded-lg" %>
    <% else %>
      <%= link_to item[:name], item[:path],
        class: "text-gray-500 hover:text-gray-700 hover:bg-gray-100 px-4 py-2 font-medium text-sm rounded-lg transition" %>
    <% end %>
  <% end %>
</nav>
