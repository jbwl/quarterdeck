<div class="space-y-6">
  <!-- Countries -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <%= render "matey/shared/data_table", title: "Countries", label: "Country", count_label: "Visits", data: @countries %>

    <% if @countries.any? %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-4">Top Countries</h3>
        <div class="h-64">
          <canvas
            data-controller="chart"
            data-chart-type-value="doughnut"
            data-chart-labels-value="<%= @countries.keys.first(8).to_json %>"
            data-chart-data-value="<%= @countries.values.first(8).to_json %>"
          ></canvas>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Regions & Cities -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <%= render "matey/shared/data_table", title: "Regions", label: "Region", count_label: "Visits", data: @regions %>
    <%= render "matey/shared/data_table", title: "Cities", label: "City", count_label: "Visits", data: @cities %>
  </div>
</div>
